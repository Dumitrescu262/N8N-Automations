    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f=$json;const w=String(f.targetChannelName||'').trim().toLowerCase();const matches=(f.teamChannels||[]).filter(c=>String(c.channelName||'').trim().toLowerCase()===w);if(matches.length!==1)return{json:{...f,channelResolutionError:true}};return{json:{...f,targetChannelId:matches[0].channelId,targetChannelName:matches[0].channelName,channelResolutionError:false}}"
      },
      "id": "5c1345fa-4b06-4ddc-b44d-22e17606fd3d",
      "name": "Rezolvă ID Canal (din cache)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -16
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f=$json;if(f.channelResolutionError)return{json:{...f,skipSend:true}};const mentions=[];const at=u=>{const i=mentions.length;mentions.push({id:i,mentionText:u.displayName,mentioned:{user:{id:u.id,displayName:u.displayName,userIdentityType:'aadUser'}}});return`<at id=\"${i}\">${u.displayName}</at>`};const responsible=(f.responsibleUsers||[]).filter(u=>u?.id);const sender=(f.authorId&&f.authorName)?{id:f.authorId,displayName:f.authorName}:null;const r=responsible.map(at).join(', ');let s='';if(sender&&!responsible.some(u=>u.id===sender.id)){s=at(sender);}const urgentPrefix=f.ai?.urgency==='URGENT'?'[URGENT] ':'';const content=`${urgentPrefix}${r}${s?' '+s:''} — reminder: solicitarea din mesajul inițial nu are încă un reply din partea persoanei responsabile.${f.deadlineDate?' Termen: '+f.deadlineDate+(f.deadlineTime?' '+f.deadlineTime:'')+'.':''}${f.ai?.expectedAction?' Se așteaptă: '+f.ai.expectedAction+'.':''}`;return{json:{...f,skipSend:false,replyContent:content,replyMentions:mentions}}"
      },
