    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f=$json;const ai=f.ai||{};const t=ai.targetChannel||{};const name=t.resolution==='ORIGINAL'||!t.channelName?f.originalChannelName:t.channelName;const stableUsers=(ai.responsibleUsers||[]).map(u=>u&&u.id).filter(Boolean).sort().join(',');const key=`${f.teamId}:${f.messageId}:${name.toLowerCase()}:${stableUsers}`;return{json:{...f,targetChannelName:name,targetChannelResolution:t.resolution||'ORIGINAL',notificationKey:key}}"
      },
      "id": "62e26580-e0b0-4f00-9fae-2907af86f67a",
      "name": "Pregătește Canalul și Cheia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all();const seen=new Set();const out=[];\nfor(const it of items){const f=it.json;\n if(f.notificationKey){if(seen.has(f.notificationKey))continue;seen.add(f.notificationKey);out.push(it);continue;}\n const users=((f.ai&&f.ai.responsibleUsers)||[]).map(u=>u.id).filter(Boolean).sort().join(',');\n const chan=String(f.targetChannelName||'').trim().toLowerCase();\n const key=`${f.teamId}:${f.messageId}:${chan}:${users}`;\n if(seen.has(key))continue;\n seen.add(key);\n out.push(it);\n}\nreturn out;"
      },
      "id": "d3e31d28-3d1f-4d3a-b352-43798b4974f6",
      "name": "Elimină Task-uri Duplicate (Același Canal)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a",
              "leftValue": "={{ $json.targetChannelResolution }}",
              "operator": {
                "operation": "notEquals",
                "type": "string",
                "rightValue": "AMBIGUOUS"
              }
            }
          ],
