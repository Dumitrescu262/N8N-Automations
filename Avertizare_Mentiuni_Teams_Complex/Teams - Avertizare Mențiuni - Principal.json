      "id": "51811a7a-66ad-442e-a105-714e9d1ef813",
      "name": "Obține Mesaje Canal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1984,
        0
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "lUB1iQvR7IWOHM4q",
          "name": "Microsoft Teams account 24"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all(),out=[];\nconst cfg=$('Configurare').first().json;\nfor(let i=0;i<items.length;i++){const resp=items[i].json,ch=$('Buclă Canale').itemMatching(i).json;\n for(const m of(resp.value||[])){if(m.deletedDateTime||!m.mentions?.length)continue;\n  const hasWide=m.mentions.some(x=>x?.mentioned?.team||x?.mentioned?.channel||x?.mentioned?.tag||x?.mentioned?.conversation||x?.mentioned?.group);\n  if(hasWide)continue;\n  const seen=new Set(),mentions=[]; for(const x of m.mentions){const u=x?.mentioned?.user;if(u?.id&&!seen.has(u.id)){seen.add(u.id);mentions.push({id:u.id,displayName:u.displayName||x.mentionText||''});}}\n  if(!mentions.length)continue;\n  out.push({json:{teamId:ch.teamId,teamName:ch.teamName,originalChannelId:ch.channelId,originalChannelName:ch.channelName,teamChannels:ch.teamChannels||[],cfg,messageId:m.id,createdDateTime:m.createdDateTime,webUrl:m.webUrl||'',messageBodyHtml:m.body?.content||'',authorId:m.from?.user?.id||'',authorName:m.from?.user?.displayName||'',mentions}});\n }} return out;"
      },
