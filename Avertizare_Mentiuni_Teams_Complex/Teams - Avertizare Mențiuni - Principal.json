      "id": "1cc03f9c-36df-46ee-b355-f1b3ba22b5d4",
      "name": "Obține Canale",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1360,
        176
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "lUB1iQvR7IWOHM4q",
          "name": "Microsoft Teams account 24"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all();const teamItem=$('Buclă Echipe').first().json;const sd=$getWorkflowStaticData('global');if(!Array.isArray(sd.allChannels))sd.allChannels=[];let count=0;for(const it of items){for(const ch of(it.json.value||[])){sd.allChannels.push({teamId:teamItem.id,teamName:teamItem.displayName,channelId:ch.id,channelName:ch.displayName});count++;}}return [{json:{teamId:teamItem.id,teamName:teamItem.displayName,channelsFound:count}}];"
      },
      "id": "9a03fbe5-abd3-4907-b43a-9b4c5a93d91e",
      "name": "Pregătește Lista Canalelor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global');const list=Array.isArray(sd.allChannels)?sd.allChannels:[];const byTeam={};for(const ch of list){(byTeam[ch.teamId]=byTeam[ch.teamId]||[]).push({channelId:ch.channelId,channelName:ch.channelName});}return list.map(ch=>({json:{...ch,teamChannels:byTeam[ch.teamId]||[]}}));"
      },
      "id": "bed5ebfd-95b8-4804-a2ff-c2bcb58b6c78",
      "name": "Citește Toate Canalele",
      "type": "n8n-nodes-base.code",
