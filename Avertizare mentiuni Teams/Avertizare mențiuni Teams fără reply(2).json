      "id": "8698e246-7ec7-4bb2-9852-c102586387bc",
      "name": "Obține Mesaje Canal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2128,
        112
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "lUB1iQvR7IWOHM4q",
          "name": "Microsoft Teams account 24"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cfg = $('Configurare Prag').first().json;\nconst now = Date.now();\nconst mentionDelayMs = (cfg.mentionDelayDays || 2) * 24 * 60 * 60 * 1000;\nconst maxLookbackMs = (cfg.maxLookbackDays || 14) * 24 * 60 * 60 * 1000;\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const channel = $('Buclă Canale').itemMatching(i).json;\n  const messages = resp.value || [];\n  for (const m of messages) {\n    if (m.deletedDateTime) continue;\n    if (!m.mentions || m.mentions.length === 0) continue;\n    const created = new Date(m.createdDateTime).getTime();\n    const age = now - created;\n    if (age < mentionDelayMs) continue;\n    if (age > maxLookbackMs) continue;\n    const seenUserIds = {};\n    const userMentions = [];\n    for (const mm of m.mentions) {\n      if (mm.mentioned && mm.mentioned.user && mm.mentioned.user.id) {\n        const uid = mm.mentioned.user.id;\n        if (!seenUserIds[uid]) {\n          seenUserIds[uid] = true;\n          userMentions.push({ id: uid, displayName: mm.mentioned.user.displayName || mm.mentionText });\n        }\n      }\n    }\n    if (userMentions.length === 0) continue;\n    out.push({ json: {\n      teamId: channel.teamId, teamName: channel.teamName,\n      channelId: channel.channelId, channelName: channel.channelName,\n      messageId: m.id, createdDateTime: m.createdDateTime, webUrl: m.webUrl || '',\n      userMentions: userMentions\n    } });\n  }\n}\nreturn out;"
      },
      "id": "29a6e4be-0009-4cc4-99f6-d8e675cc3796",
      "name": "Filtrează Mențiuni Vechi de 2+ Zile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2368,
        112
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.microsoft.com/v1.0/teams/{{ $json.teamId }}/channels/{{ $json.channelId }}/messages/{{ $json.messageId }}/replies",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftTeamsOAuth2Api",
        "options": {}
      },
      "id": "586f97e6-ce53-4fef-9f7f-265b440fcbde",
      "name": "Obține Reply-uri Mesaj",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2592,
        112
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "lUB1iQvR7IWOHM4q",
          "name": "Microsoft Teams account 24"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const replies = (items[i].json.value) || [];\n  const cand = $('Filtrează Mențiuni Vechi de 2+ Zile').itemMatching(i).json;\n  for (const um of cand.userMentions) {\n    const replied = replies.some(function (r) { return r.from && r.from.user && r.from.user.id === um.id; });\n    if (!replied) {\n      out.push({ json: {\n        teamId: cand.teamId, teamName: cand.teamName,\n        channelId: cand.channelId, channelName: cand.channelName,\n        messageId: cand.messageId, createdDateTime: cand.createdDateTime, webUrl: cand.webUrl,\n        mentionedUserId: um.id, mentionedUserName: um.displayName,\n        notificationKey: cand.channelId + '_' + cand.messageId + '_' + um.id\n      } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "29d5b5d0-7094-4ac1-bdfd-8aab5f648980",
      "name": "Verifică Cine Nu a Răspuns",
