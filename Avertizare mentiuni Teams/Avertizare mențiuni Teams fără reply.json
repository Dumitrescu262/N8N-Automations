    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const team = $('Buclă Echipe').itemMatching(i).json;\n  const channels = resp.value || [];\n  for (const ch of channels) {\n    out.push({ json: { teamId: team.id, teamName: team.displayName, channelId: ch.id, channelName: ch.displayName } });\n  }\n}\nreturn out;"
      },
