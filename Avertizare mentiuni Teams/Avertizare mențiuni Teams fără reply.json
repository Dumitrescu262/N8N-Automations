    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $json;\nconst days = Math.floor((Date.now() - new Date(f.createdDateTime).getTime()) / 86400000);\nconst text = '<at id=\"0\">' + f.mentionedUserName + '</at> reminder: ai fost mentionat/a in acest mesaj acum ' + days + ' zile si inca nu ai raspuns. Te rugam sa raspunzi cat mai curand.';\nreturn { json: Object.assign({}, f, {\n  replyContent: text,\n  replyMentions: [ { id: 0, mentionText: f.mentionedUserName, mentioned: { user: { id: f.mentionedUserId, displayName: f.mentionedUserName, userIdentityType: 'aadUser' } } } ]\n}) };"
      },
