      "id": "04e2eff6-151f-4dbc-ae7f-d81443decdb6",
      "name": "Obține Mesaje Canal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -1200,
        448
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "kc8BiG6HeFHsToIj",
          "name": "Microsoft Teams account 25"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cfg = $('Configurare Prag').first().json;\nconst now = Date.now();\nconst mentionDelayMs = (cfg.mentionDelayDays || 2) * 24 * 60 * 60 * 1000;\nconst maxLookbackMs = (cfg.maxLookbackDays || 14) * 24 * 60 * 60 * 1000;\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const channel = $('Buclă Canale').itemMatching(i).json;\n  const messages = resp.value || [];\n  for (const m of messages) {\n    if (m.deletedDateTime) continue;\n    if (!m.mentions || m.mentions.length === 0) continue;\n    const created = new Date(m.createdDateTime).getTime();\n    const age = now - created;\n    if (age < mentionDelayMs) continue;\n    if (age > maxLookbackMs) continue;\n    const seenUserIds = {};\n    const userMentions = [];\n    for (const mm of m.mentions) {\n      if (mm.mentioned && mm.mentioned.user && mm.mentioned.user.id) {\n        const uid = mm.mentioned.user.id;\n        if (!seenUserIds[uid]) {\n          seenUserIds[uid] = true;\n          userMentions.push({ id: uid, displayName: mm.mentioned.user.displayName || mm.mentionText });\n        }\n      }\n    }\n    if (userMentions.length === 0) continue;\n    out.push({ json: {\n      teamId: channel.teamId, teamName: channel.teamName,\n      channelId: channel.channelId, channelName: channel.channelName,\n      messageId: m.id, createdDateTime: m.createdDateTime, webUrl: m.webUrl || '',\n      userMentions: userMentions\n    } });\n  }\n}\nreturn out;"
      },
      "id": "4e4b8c0c-f3ed-4bc3-aa44-a1be6d16989d",
      "name": "Filtrează Mențiuni Vechi de 2+ Zile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        448
