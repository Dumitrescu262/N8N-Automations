    {
      "parameters": {
        "url": "=https://graph.microsoft.com/v1.0/teams/{{ $json.teamId }}/channels/{{ $json.channelId }}/messages/{{ $json.messageId }}/replies",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftTeamsOAuth2Api",
        "options": {}
      },
      "id": "5914d809-5500-4179-8c2b-1a1acdbe939e",
      "name": "Obține Reply-uri Mesaj",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -736,
        448
      ],
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "kc8BiG6HeFHsToIj",
          "name": "Microsoft Teams account 25"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const replies = (items[i].json.value) || [];\n  const cand = $('Filtrează Mențiuni Vechi de 2+ Zile').itemMatching(i).json;\n  for (const um of cand.userMentions) {\n    const replied = replies.some(function (r) { return r.from && r.from.user && r.from.user.id === um.id; });\n    if (!replied) {\n      out.push({ json: {\n        teamId: cand.teamId, teamName: cand.teamName,\n        channelId: cand.channelId, channelName: cand.channelName,\n        messageId: cand.messageId, createdDateTime: cand.createdDateTime, webUrl: cand.webUrl,\n        mentionedUserId: um.id, mentionedUserName: um.displayName,\n        notificationKey: cand.channelId + '_' + cand.messageId + '_' + um.id\n      } });\n    }\n  }\n}\nreturn out;"
      },
